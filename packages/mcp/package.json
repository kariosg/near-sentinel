{
  "name": "@near-sentinel/mcp",
  "version": "0.1.0",
  "description": "MCP server exposing NEAR Sentinel retry-safety and transaction diagnostics to AI agents (read-only)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "near-sentinel-mcp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@near-sentinel/sdk": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "vitest": "5.1.0",
    "typescript": "5.9.3",
    "@types/node": "^22.10.0"
  }
}
