# NEAR Sentinel production settings for deploy/vultr/docker-compose.prod.yml.
#
#   cp deploy/vultr/env.production.example deploy/vultr/.env.production
#   nano deploy/vultr/.env.production
#
# .env.production is git-ignored and never baked into the image (.dockerignore excludes .env.*).
# Comments are on their own lines on purpose: Docker Compose does not strip a comment after an empty value.
#
# NO PRIVATE KEYS EVER GO ON THIS SERVER. Sentinel is read-only: it never signs or submits transactions,
# and nothing in this file is a secret key. If you are about to paste an ed25519:... secret key or a seed
# phrase anywhere on the server, stop.

# ---------------------------------------------------------------------------------------------------
# Public address (used by Caddy)
# ---------------------------------------------------------------------------------------------------

# Your hostname. Create a DNS A record for it pointing at the server's IPv4 address first.
# TEMPORARY fallback with no domain: SENTINEL_DOMAIN=:80  (plain HTTP at http://<server-ip>/, not encrypted)
SENTINEL_DOMAIN=sentinel.example.com

# Host ports Caddy publishes. Leave at 80/443 on the server (certificates need them).
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------------------------------------------
# App settings (loaded into the sentinel container)
# HOST, PORT, DATA_DIR, TRUST_PROXY, METRICS_HOST and NODE_ENV are fixed by docker-compose.prod.yml.
# ---------------------------------------------------------------------------------------------------

# testnet | mainnet. Keep testnet unless you have a reason not to.
NEAR_NETWORK=testnet

# Optional: your deployed Sentinel Guard contract, shown by default in the dashboard.
# This is a PUBLIC NEAR account ID (like an address), not a key. guard.karios.testnet is the live demo deployment; leave empty for none.
GUARD_CONTRACT_ID=guard.karios.testnet
# Optional: Sentinel Vault contract (public account ID) for the dashboard's allowance panel.
VAULT_CONTRACT_ID=vault.karios.testnet

# Optional: override the default RPC providers: name=url|operator,name=url|operator
# RPC_URLS=

RPC_TIMEOUT_MS=10000
# Independent operators that must each prove non-execution before SAFE_TO_RETRY
MIN_INDEPENDENT_OPERATORS=2

LOG_LEVEL=info

# Protected endpoints (POST /api/v1/providers, POST /api/v1/benchmarks/run).
# Comma-separated SHA-256 hex digests of API keys, never the keys themselves. Empty = disabled (safest).
# Generate a key and its digest ON YOUR OWN COMPUTER, keep the key in your password manager, and put only
# the sha256 line here:
#   node -e "const c=require('crypto');const k=c.randomBytes(24).toString('hex');console.log('key:',k);console.log('sha256:',c.createHash('sha256').update(k).digest('hex'))"
API_KEYS_SHA256=

# Requests per minute per client IP
RATE_LIMIT_MAX=120
# Inspections per minute per client IP (each one fans out to every provider)
INSPECT_RATE_LIMIT_MAX=30

# Comma-separated allowed cross-origin callers; empty = same-origin only (the dashboard is same-origin).
CORS_ORIGINS=

PROBE_INTERVAL_MS=30000
CAPABILITY_INTERVAL_MS=600000
LAG_THRESHOLD_BLOCKS=50

# Prometheus listener inside the container (never published). 0 disables it.
METRICS_PORT=9464

# Must stay 0 in production (it allows localhost/private RPC URLs).
ALLOW_PRIVATE_RPC=0
