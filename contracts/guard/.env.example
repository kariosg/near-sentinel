# Sentinel Guard deployment + live testnet integration test. Copy to .env (git-ignored) and fill in YOURSELF.
# TESTNET only. Never put a mainnet key here. Never paste these values into chat, issues or commits.

# The account the contract is deployed to (you create it, e.g. guard.<you>.testnet), and its FullAccess key.
GUARD_CONTRACT_ID=guard.your-account.testnet
GUARD_CONTRACT_PRIVATE_KEY=

# For the live integration test (pnpm --filter @near-sentinel/guard test:testnet):
# a payer account you control (pays through the guard) and a receiver account.
GUARD_TEST_PAYER_ACCOUNT_ID=your-agent.testnet
GUARD_TEST_PAYER_PRIVATE_KEY=
GUARD_TEST_RECEIVER_ACCOUNT_ID=your-receiver.testnet

# Optional
# GUARD_RPC_URL=https://test.rpc.fastnear.com
