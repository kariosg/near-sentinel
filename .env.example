# NEAR Sentinel API configuration. Copy to .env (git-ignored). All values are optional.
# Comments are on their own lines on purpose: Docker Compose does not strip a comment after an empty value.

# testnet | mainnet
NEAR_NETWORK=testnet
# Override the default providers: name=url|operator,name=url|operator
# RPC_URLS=fastnear=https://test.rpc.fastnear.com|fastnear,drpc=https://near-testnet.drpc.org|drpc
RPC_TIMEOUT_MS=10000
# Independent operators that must each prove non-execution before SAFE_TO_RETRY
MIN_INDEPENDENT_OPERATORS=2
# Optional: your deployed Sentinel Guard contract (a public account ID, not a key), shown by default in the dashboard
# GUARD_CONTRACT_ID=guard.karios.testnet   (the public demo deployment)
# Optional: your Sentinel Vault contract (public account ID), shown by default in the dashboard
# VAULT_CONTRACT_ID=vault.karios.testnet   (the public demo deployment)
# NEVER put private keys in this file: Docker Compose loads it into the API container. Keys belong only in
# contracts/guard/.env and examples/agent-demo/.env (both git-ignored and never loaded by the API).

HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
LOG_LEVEL=info

# Protected endpoints (POST /api/v1/providers, POST /api/v1/benchmarks/run).
# Comma-separated SHA-256 hex digests of your API keys, never the keys themselves. Empty = disabled.
# Generate a key and its digest:
#   node -e "const c=require('crypto');const k=c.randomBytes(24).toString('hex');console.log('key:',k);console.log('sha256:',c.createHash('sha256').update(k).digest('hex'))"
API_KEYS_SHA256=

# Privacy: client IPs in the audit log are stored only as an HMAC with this salt (16+ characters).
# Empty = a random salt per start, so hashes cannot be linked across restarts. See docs/PRIVACY.md.
AUDIT_IP_SALT=

# Requests per minute per client IP
RATE_LIMIT_MAX=120
# Inspections per minute per client IP (each one fans out to every provider)
INSPECT_RATE_LIMIT_MAX=30
# Set to 1 only behind a reverse proxy you control
TRUST_PROXY=0
# Comma-separated allowed origins; empty = same-origin only
CORS_ORIGINS=

PROBE_INTERVAL_MS=30000
CAPABILITY_INTERVAL_MS=600000
LAG_THRESHOLD_BLOCKS=50

METRICS_HOST=127.0.0.1
# 0 disables the Prometheus listener
METRICS_PORT=9464

# Local development only (fault-injection proxy on localhost). Never enable in production.
ALLOW_PRIVATE_RPC=0
