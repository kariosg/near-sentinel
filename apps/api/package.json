{
  "name": "@near-sentinel/api",
  "version": "0.1.0",
  "private": true,
  "description": "NEAR Sentinel REST API: inspection, retry-safety, provider health, incidents, benchmarks (read-only)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "node --watch --experimental-strip-types --no-warnings=ExperimentalWarning src/server.ts",
    "test:load": "node scripts/load-test.mjs",
    "start": "node --env-file-if-exists=../../.env --no-warnings=ExperimentalWarning dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@near-sentinel/agent-demo": "workspace:*",
    "@near-sentinel/sdk": "workspace:*",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "autocannon": "8.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "files": [
    "dist"
  ]
}
