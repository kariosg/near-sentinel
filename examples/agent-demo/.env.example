# Real-testnet demo configuration. Copy to .env (git-ignored) and fill in YOURSELF.
# Use TESTNET accounts that you created. Never put a mainnet key here.
DEMO_SENDER_ACCOUNT_ID=your-sender.testnet
# FullAccess key of the sender, format ed25519:<base58>. Paste it here yourself — never in chat or git.
DEMO_SENDER_PRIVATE_KEY=
DEMO_RECEIVER_ACCOUNT_ID=your-receiver.testnet
# Per-transfer amount in NEAR (max 0.1). The demo signs at most 4 transfers (normally 3 execute).
DEMO_AMOUNT_NEAR=0.01
# Optional
# DEMO_RPC_URL=https://test.rpc.fastnear.com
